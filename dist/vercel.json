{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "molly-lang",
          "value": "en"
        }
      ],
      "destination": "/en/index.html"
    },
    {
      "source": "/",
      "destination": "/zh/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "cookie",
          "key": "molly-lang",
          "value": "en"
        }
      ],
      "destination": "/en/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/zh/:path*"
    }
  ],
  "headers": [
    {
      "source": "/_videos/v1/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/quicktime"
        }
      ]
    }
  ]
}
